# ── Required ─────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/trendbot_growth
# Public URL of this app (Twilio + Google call back here). Must be https in production.
APP_URL=https://growth.trendbotagency.com
# 32+ random characters. Generate: openssl rand -base64 48
APP_SECRET=
# Allow new agency sign-ups after the first account (normally false)
ALLOW_SIGNUP=false
# Protects /api/cron/sync. Generate: openssl rand -hex 24
CRON_SECRET=

# ── Twilio: call tracking, missed-call text-back, SMS inbox ─
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only set to false for local curl testing
TWILIO_VALIDATE_SIGNATURE=true

# ── Google Business Profile: reviews + profile health ──────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Claude: AI review replies ─────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
